---
import { SITE } from "../data/site";

const links = [
  { href: "/news/", label: "お知らせ" },
  { href: "/events/", label: "企画" },
  { href: "/mogiten/", label: "模擬店" },
  { href: "/access/", label: "アクセス" },
];
---

<header class="bg-green-700 text-white">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-2 px-4 py-3">
    <a href="/" class="text-lg font-bold">{SITE.name}</a>
    <nav>
      <ul class="flex gap-4 text-sm">
        {links.map((link) => (
          <li><a href={link.href} class="hover:underline">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
