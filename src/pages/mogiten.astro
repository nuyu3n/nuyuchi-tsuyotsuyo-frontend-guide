---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.tsx";
import LikeCounter from "../components/LikeCounter.tsx";
import { menu } from "../data/menu";
---

<BaseLayout title="模擬店「もぎてん」" description="模擬店「もぎてん」のメニューです。">
  <h1 class="text-2xl font-bold">模擬店「もぎてん」</h1>
  <p class="mt-2">中庭のテント ／ 10:00〜15:00</p>

  <h2 class="mt-6 text-xl font-bold">メニュー</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    {menu.map((item) => <MenuCard item={item} client:visible />)}
  </div>

  <h2 class="mt-8 text-xl font-bold">応援する</h2>
  <div class="mt-2">
    <LikeCounter client:idle />
  </div>
</BaseLayout>
